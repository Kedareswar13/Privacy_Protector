# .env.example - copy to .env and fill secrets (DO NOT commit .env)
APP_ENV=development
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Database (leave commented for local SQLite, uncomment for Postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/privacyprotector

# JWT
JWT_SECRET=supersecretreplace_in_prod

# Ollama (local LLM — must be running)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:latest

# Serper Web Search (get key at https://serper.dev)
SERPER_API_KEY=

# GitHub (optional — for social search)
GITHUB_TOKEN=

# HIBP (optional — for breach checks, get key at https://haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# Pseudonymization
PSEUDONYM_SALT=some_random_salt_in_dev

# Dev flags (set to true to use mock data for all external APIs)
MOCK_CONNECTORS=false
